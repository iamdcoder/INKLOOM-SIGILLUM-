# Local development defaults. Replace secrets before any deployment.
APP_ENV=development
APP_NAME=Inkloom Sigillum
API_V1_PREFIX=/api/v1

# Local SQLite is the default. PostgreSQL requires the PostgreSQL CI / deployment setup.
DATABASE_URL=sqlite:///./data/sigillum.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Private file storage. Use STORAGE_BACKEND=s3 only with a provisioned private bucket.
STORAGE_BACKEND=local
STORAGE_ROOT=./data/private_uploads
S3_ENDPOINT_URL=
S3_BUCKET=sigillum-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_VERIFY_SSL=true

BRAND_PACK_PATH=./fixtures/brand_pack/v1
MAX_UPLOAD_BYTES=10485760

# Replace with a randomly generated secret of at least 32 characters before deployment.
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=480
FILE_GRANT_MINUTES=5
SIGILLUM_DEMO_PASSWORD=ChangeMe-Local-Only
CORS_ORIGINS=http://localhost:3000
TESSERACT_CMD=tesseract
